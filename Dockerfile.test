# テスト実行用 Dockerfile
FROM ghcr.io/gleam-lang/gleam:v1.13.0-erlang-alpine

RUN apk add --no-cache inotify-tools

WORKDIR /app

# 依存関係ファイルをコピー
COPY gleam.toml manifest.toml ./

# 依存関係をダウンロード
RUN gleam deps download

# Note: src/, test/, feeds.json は docker-compose.yaml でボリュームマウントされる

ENTRYPOINT []
CMD ["gleam", "test"]
