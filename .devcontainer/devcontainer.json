{
  "name": "Gleam",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "initializeCommand": "bash .devcontainer/init-host.sh",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "mounts": [
    "source=/tmp/.claude-config-${localWorkspaceFolderBasename},target=/tmp/.claude-config,type=bind,readonly",
    "source=rss-yoriyori-claude,target=/root/.claude,type=volume",
    "source=${localEnv:HOME}/.ssh,target=/root/.ssh,type=bind,readonly",
    "source=${localEnv:HOME}/.config/gcloud,target=/root/.config/gcloud,type=bind",
    "source=rss-yoriyori-gh,target=/root/.config/gh,type=volume",
    "source=rss-yoriyori-zshhistory,target=/commandhistory,type=volume"
  ],
  "containerEnv": {
    "HISTFILE": "/commandhistory/.zsh_history",
    "SHELL": "/bin/zsh",
    "HOST_PROJECT_PATH": "${localWorkspaceFolder}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "gleam.gleam",
        "hashicorp.terraform"
      ],
      "settings": {}
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh"
}